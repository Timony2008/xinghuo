# 四solver配置；所有角色和全场strategy统一使用DeepSeek Flash。
XINGHUO_TEAM_PROFILE=flash4
XINGHUO_PROVIDER=deepseek
DEEPSEEK_API_KEY=请替换为你的DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=http://api.deepseek.com.tsecbench.gw/anthropic
XINGHUO_STRATEGY_MODEL=deepseek-flash
XINGHUO_RUN_MODE=new
XINGHUO_RUN_DIR=/work/run
XINGHUO_BUDGET_SECONDS=28800
XINGHUO_PARALLEL=3
XINGHUO_NO_FLAG_TIMEOUT=900
# 每题累计实际运行15分钟没有新增平台确认的正确flag，就跳题；新flag重新计时。
# BENCHMARK_BASE_URL / BENCHMARK_TOKEN由平台注入。
# 8小时含180秒收尾。恢复仅用于原持久目录，不会重新计时或变更成员配置／跳题规则。
