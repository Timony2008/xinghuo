# Build the same complete tool image for linux/amd64 first (see build_hosted_image.sh).
ARG VERIA_TOOLS_IMAGE=xinghuo-veria-tools:full-amd64-20261016
FROM ${VERIA_TOOLS_IMAGE}
ENV PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1 HOME=/work/home
COPY requirements-veria.lock requirements-hosted.txt /opt/xinghuo/
RUN uv pip install --python /opt/sdk/bin/python -r /opt/xinghuo/requirements-hosted.txt
COPY pyproject.toml /opt/xinghuo/app/
COPY src /opt/xinghuo/app/src
COPY scripts/veria_container_exec.py /usr/local/bin/xinghuo_exec.py
COPY scripts/veria_tool_acceptance.py /opt/xinghuo/veria_tool_acceptance.py
RUN uv pip install --python /opt/sdk/bin/python --no-deps /opt/xinghuo/app \
    && /opt/sdk/bin/python -c 'import hashlib,json,pathlib; root=pathlib.Path("/opt/xinghuo/app"); files=sorted(p for p in root.rglob("*") if p.is_file() and p.suffix in {".py",".toml",".txt",".md"} and not any(part.endswith(".egg-info") for part in p.parts)); manifest={str(p.relative_to(root)):hashlib.sha256(p.read_bytes()).hexdigest() for p in files}; manifest["tool_helper"]=hashlib.sha256(pathlib.Path("/usr/local/bin/xinghuo_exec.py").read_bytes()).hexdigest(); manifest["tool_acceptance"]=hashlib.sha256(pathlib.Path("/opt/xinghuo/veria_tool_acceptance.py").read_bytes()).hexdigest(); pathlib.Path("/opt/xinghuo/HOSTED_IMAGE.json").write_text(json.dumps({"format":1,"files":manifest},sort_keys=True))' \
    && useradd --uid 10001 --create-home --home-dir /work/home agent \
    && mkdir -p /work/run /work/home/.local/share/containers /work/home/.cache \
    && chown -R 10001:10001 /work \
    && uv cache clean
USER 10001:10001
WORKDIR /work
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/opt/sdk/bin/python", "-m", "xinghuo.hosted"]
